<view name="dept_emp_latest_date" layers="0" collapse-mode="2" max-obj-count="1" z-value="0">
	<schema name="public"/>
	<role name="mauricio"/>
	<position x="80" y="500"/>
	<reference object="employees.dept_emp" type="table" ref-name="dept_emp" use-signature="true"/>
	<simplecol name="emp_no" type="bigint"/>
	<simplecol name="from_date" type="date"/>
	<simplecol name="to_date" type="date"/>
	<definition> <![CDATA[ SELECT emp_no,
    max(from_date) AS from_date,
    max(to_date) AS to_date
   FROM dept_emp
  GROUP BY emp_no;]]> </definition>
</view>

<relationship name="rel_dept_emp_latest_date_dept_emp" type="reltv" layers="0"
	 custom-color="#df2f37"
	 src-table="public.dept_emp_latest_date"
	 dst-table="employees.dept_emp"
	 src-required="false" dst-required="false"/>

<view name="current_dept_emp" layers="0" collapse-mode="2" max-obj-count="2" z-value="0">
	<schema name="public"/>
	<role name="mauricio"/>
	<position x="240" y="200"/>
	<reference object="employees.dept_emp" type="table" ref-name="dept_emp" use-signature="true"/>
	<reference object="public.dept_emp_latest_date" type="view" ref-name="dept_emp_latest_date" use-signature="true"/>
	<simplecol name="emp_no" type="bigint"/>
	<simplecol name="dept_no" type="character(4)"/>
	<simplecol name="from_date" type="date"/>
	<simplecol name="to_date" type="date"/>
	<definition> <![CDATA[ SELECT l.emp_no,
    d.dept_no,
    l.from_date,
    l.to_date
   FROM (dept_emp d
     JOIN dept_emp_latest_date l ON (((d.emp_no = l.emp_no) AND (d.from_date = l.from_date) AND (d.to_date = l.to_date))));]]> </definition>
</view>

<relationship name="rel_current_dept_emp_dept_emp" type="reltv" layers="0"
	 custom-color="#e24118"
	 src-table="public.current_dept_emp"
	 dst-table="employees.dept_emp"
	 src-required="false" dst-required="false"/>

<relationship name="rel_current_dept_emp_dept_emp_latest_date" type="reltv" layers="0"
	 custom-color="#34156a"
	 src-table="public.current_dept_emp"
	 dst-table="public.dept_emp_latest_date"
	 src-required="false" dst-required="false"/>

